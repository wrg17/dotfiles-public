#!/usr/bin/env bash
# Starts colima with resources scaled to this machine's hardware.
# --cpu and --memory are recomputed each invocation.
# --vm-type/--mount-type/--disk apply only on first start (VM creation);
# colima ignores them on restart if the VM already exists.
set -euo pipefail

cpu=$(( $(sysctl -n hw.logicalcpu) / 2 ))
mem=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 / 4 ))
(( cpu < 2 )) && cpu=2
(( mem < 2 )) && mem=2

macos_major=$(sw_vers -productVersion | cut -d. -f1)
if (( macos_major >= 13 )); then
  vm_type=vz
  mount_type=virtiofs
else
  vm_type=qemu
  mount_type=9p
fi

exec colima start \
  --cpu "$cpu" \
  --memory "$mem" \
  --disk 60 \
  --vm-type "$vm_type" \
  --mount-type "$mount_type" \
  "$@"
