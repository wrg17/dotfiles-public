build-essential
libssl-dev
zlib1g-dev
libbz2-dev
libreadline-dev
libsqlite3-dev
# Real package name. libncursesw5-dev still resolves on noble, but only as a
# transitional virtual package provided by this one.
libncurses-dev
xz-utils
tk-dev
libxml2-dev
libxmlsec1-dev
libffi-dev
liblzma-dev
libyaml-dev

# C++ / LLVM toolchain
clang
lld
lldb

# Core tools
tmux
wezterm
# `watch` is a virtual package provided solely by procps, so apt resolves it.
# Left as the command name because that is what it is used as; do not "fix" it
# to procps without checking test/bootstrap.bats.
watch

# NFS client — mount.nfs and friends, needed for /etc/fstab NFS mounts
nfs-common

# Backups — borg-backup runs from a systemd user timer, before any shell
# environment is loaded, so this belongs on apt rather than Homebrew
borgbackup

# sqlite3 CLI — borg-dump-services uses `.backup` to snapshot live WAL-mode
# databases; without it they are archived as raw files and may restore torn
sqlite3

# Modern replacements for ls/cat/find — wired up as aliases in .zshrc
# fd is named fd-find on Ubuntu; the zshrc alias handles the rename
eza
bat
fd-find

# Shell integrations — lazily hooked into .zshrc via _initcache
zoxide
direnv

# Docker
docker-ce
docker-ce-cli
containerd.io
docker-buildx-plugin
docker-compose-plugin

# Rootless Docker.
#
# This machine runs the daemon as a systemd *user* service with its data-root in
# ~/.local/share/docker, not the system daemon. That is load-bearing for the
# backup: volume contents are owned by a mapped subuid, so borg-dump-services
# reads them through a container rather than needing host root. None of these
# were declared, so a rebuilt machine would have come up with the system daemon
# instead and the volume dumps would have had nothing to read.
#
# After installing, enable it with: dockerd-rootless-setuptool.sh install
docker-ce-rootless-extras
uidmap
dbus-user-session

# GPU containers. linux.sh already adds the NVIDIA Container Toolkit repo but
# never installed anything from it, so the repo sat there unused.
nvidia-container-toolkit

