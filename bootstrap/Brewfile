# Modern replacements for ls/cat/find (eza, bat, fd) — installed by
# bootstrap/install-tools.sh, not from here. All three are Rust, so on a mac
# below Homebrew's bottle floor `brew install` builds rust and llvm first.

# Shell integrations (zoxide, direnv) — installed from upstream binaries by
# bootstrap/install-tools.sh, not from here: Homebrew has no bottles for macOS
# below its support floor, where `brew install zoxide` would build llvm.

# Shell, editor, file manager — installed via bootstrap/install-tools.sh

# Container tooling (colima replaces Docker Desktop — no daemon, no license)
brew "colima"
brew "docker"
brew "docker-compose"
brew "docker-buildx"
brew "docker-credential-helper"

# GUI apps
cask "wezterm"
